# Camera sensors for the Milk-V Duo S that mainline does not have yet.
# Sourced inside the "Camera sensor devices" menu of drivers/media/i2c/Kconfig.

config VIDEO_GC2083
	tristate "GalaxyCore GC2083 sensor support"
	select V4L2_CCI_I2C
	help
	  This is a Video4Linux2 sensor driver for the GalaxyCore GC2083
	  camera.

	  To compile this driver as a module, choose M here: the
	  module will be called gc2083.

config VIDEO_IMX708
	tristate "Sony IMX708 sensor support"
	depends on GPIOLIB
	select V4L2_CCI_I2C
	select VIDEO_CCS_PLL
	help
	  This is a Video4Linux2 sensor driver for the Sony
	  IMX708 camera.

	  To compile this driver as a module, choose M here: the
	  module will be called imx708.
